{
    "$schema": "https://sing-box.sagernet.org/schema.json",
    "log": {"level": "error","timestamp": true},
    "experimental": { "cache_file": {"enabled": true,"store_fakeip": true}},
    "dns": {
        "servers": [
            {
                "tag": "dns-cn",
                "type": "udp",
                "server": "223.5.5.5"
            },
            {
                "tag": "fakeip",
                "type": "fakeip",
                "inet4_range": "198.18.0.0/15",
                "inet6_range": "2001:2::/48"
            }
        ],
        "rules": [
            {
                "rule_set": [
                    "apple-cn",
                    "cn",
                    "games-cn",
                    "google-cn",
                    "microsoft-cn",
                    "private"
                ],
                "server": "dns-cn"
            },
            {
                "server": "fakeip"
            }
        ],
        "strategy": "prefer_ipv6",
        "optimistic": true
    },
    "inbounds": [
        {
            "tag": "tun-in",
            "type": "tun",
            "address": [
                "172.19.0.1/30",
                "fdfe:dcba:9876::1/126"
            ],
            "auto_route": true,
            "strict_route": true
        }
    ],
    "http_clients": [{"tag": "route-download","detour": "Proxy"}],
    "route": {
        "auto_detect_interface": true,
        "default_http_client": "route-download",
        "default_domain_resolver": "dns-cn",
        "final": "Proxy",
        "rules": [
            {
                "type": "logical",
                "mode": "and",
                "rules": [{"ip_version": 6 },{"default_interface_address": "2000::/3","invert": true }],
                "action": "reject",
                "no_drop": true
            },
            { "rule_set": [ "telegramip" ], "invert": true, "action": "sniff" },
            { "type": "logical", "mode": "or", "rules": [ { "protocol": [ "dns" ] }, { "port": 53 } ], "action": "hijack-dns" },
            {
                "rule_set": [
                    "private",
                    "apple-cn",
                    "applications",
                    "games-cn",
                    "google-cn",
                    "microsoft-cn"
                ],
                "outbound": "Direct"
            },
            { "rule_set": "ai","outbound": "AI"},
            { "rule_set": "games","outbound": "Games"},
            { "rule_set": "spotify","outbound": "Spotify"},
            { "rule_set": "tiktok","outbound": "TikTok"},
            { "rule_set": "proxy", "outbound": "Proxy" },
            { "rule_set": "cn", "outbound": "Direct" },
            { "ip_is_private": true, "outbound": "Direct" },
            { "rule_set": "cnip", "outbound": "Direct" },
            { "rule_set": "telegramip", "outbound": "Proxy" }
        ],
        "rule_set": [
            {
                "tag": [
                    "ai",
                    "apple-cn",
                    "applications",
                    "cn",
                    "cnip",
                    "games-cn",
                    "games",
                    "google-cn",
                    "microsoft-cn",
                    "private",
                    "proxy",
                    "spotify",
                    "telegramip",
                    "tiktok"
                ],
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/DustinWin/ruleset_geodata/raw/sing-box-ruleset/{tag}.srs"
            }
        ]
    },
    "outbounds": [
        {"tag": "Proxy","type": "selector","outbounds": ["Direct"]},
        {"tag": "AI","type": "selector","outbounds": []},
        {"tag": "Games","type": "selector","outbounds": ["Direct"]},
        {"tag": "Spotify","type": "selector","outbounds": ["Direct"]},
        {"tag": "TikTok","type": "selector","outbounds": []},
        {"tag": "Direct","type": "direct"}
    ]
}