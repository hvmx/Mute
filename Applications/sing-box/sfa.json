{
    "$schema": "https://sing-box.sagernet.org/schema.json",
    "log": {"level": "error","timestamp": true},
    "experimental": { "cache_file": {"enabled": true,"store_fakeip": true}},
    "dns": {
        "servers": [
            {
                "type": "hosts",
                "tag": "hosts",
                "predefined": {
                    "dns.alidns.com": ["223.5.5.5","223.6.6.6","2400:3200::1","2400:3200:baba::1"],
                    "dns.google": ["8.8.8.8","8.8.4.4","2001:4860:4860::8888","2001:4860:4860::8844"]
                }
            },
            { "tag": "dns-local", "type": "local" },
            {
                "tag": "dns-google",
                "type": "https",
                "server": "dns.google",
                "domain_resolver": "hosts",
                "detour": "Proxy"
            },
            {
                "tag": "dns-ali",
                "type": "quic",
                "server": "dns.alidns.com",
                "domain_resolver": "hosts"
            },
            {
                "tag": "fakeip",
                "type": "fakeip",
                "inet4_range": "198.18.0.0/15",
                "inet6_range": "2001:2::/48"
            }
        ],
        "rules": [
            { "preferred_by": ["hosts"], "server": "hosts" },
            { "rule_set": [ "private" ], "server": "dns-local" },
            { "rule_set": [ "ai", "games", "gits", "google", "youtube", "spotify", "proxy", "tld-proxy" ], "query_type": [ "A", "AAAA" ], "server": "fakeip" },
            { "rule_set": [ "googlefcm", "cn"], "server": "dns-ali" }
        ],
        "final": "dns-ali",
        "strategy": "prefer_ipv6",
        "optimistic": true,
        "reverse_mapping": true
    },
    "inbounds": [
        {
            "tag": "tun-in",
            "type": "tun",
            "address": [
                "172.19.0.1/30",
                "fdfe:dcba:9876::1/126"
            ],
            "auto_route": true,
            "strict_route": true
        }
    ],
    "http_clients": [{"tag": "default-download","detour": "Proxy"}],
    "route": {
        "auto_detect_interface": true,
        "default_http_client": "default-download",
        "default_domain_resolver": "dns-ali",
        "final": "Final",
        "rules": [
            {
                "type": "logical",
                "mode": "and",
                "rules": [{"ip_version": 6 },{"default_interface_address": "2000::/3","invert": true }],
                "action": "reject",
                "no_drop": true
            },
            { "action": "sniff" },
            { "type": "logical", "mode": "or", "rules": [ { "protocol": [ "dns" ] }, { "port": 53 } ], "action": "hijack-dns" },
            { "rule_set": "private","outbound": "Direct"},
            { "rule_set": "ai","outbound": "AI"},
            { "rule_set": "googlefcm","outbound": "FCM"},
            { "rule_set": "games","outbound": "Games"},
            { "rule_set": "gits","outbound": "Gits"},
            { "rule_set": "google","outbound": "Google"},
            { "rule_set": "youtube","outbound": "Google"},
            { "rule_set": "spotify","outbound": "Spotify"},
            { "rule_set": "proxy", "outbound": "Proxy" },
            { "rule_set": "tld-proxy", "outbound": "Proxy" },
            { "rule_set": "cn","outbound": "Direct"},
            { "ip_is_private": true, "outbound": "Direct" },
            { "rule_set": "cncidr", "outbound": "Direct" }
        ],
        "rule_set": [
            {
                "tag": [
                    "ai",
                    "cn",
                    "cncidr",
                    "games",
                    "gits",
                    "google",
                    "googlefcm",
                    "private",
                    "proxy",
                    "spotify",
                    "tld-proxy",
                    "youtube"
                ],
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/QuixoticHeart/rule-set/raw/refs/heads/ruleset/singbox/version5/{tag}.srs"
            }
        ]
    },
    "outbounds": [
        {"tag": "Proxy","type": "selector","outbounds": []},
        {"tag": "Final","type": "selector","outbounds": []},
        {"tag": "AI","type": "selector","outbounds": []},
        {"tag": "FCM","type": "selector","outbounds": []},
        {"tag": "Games","type": "selector","outbounds": []},
        {"tag": "Gits","type": "selector","outbounds": []},
        {"tag": "Google","type": "selector","outbounds": []},
        {"tag": "Spotify","type": "selector","outbounds": []},
        {"tag": "Direct","type": "direct"}
    ]
}