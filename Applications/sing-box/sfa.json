{
    "$schema": "https://sing-box.sagernet.org/schema.json",
    "log": {
        "disabled": true,
        "level": "info",
        "output": "sing-box.log",
        "timestamp": true
    },
    "dns": {
        "servers": [
            {
                "tag": "dns-cn",
                "type": "udp",
                "server": "223.5.5.5"
            },
            {
                "tag": "dns-proxy",
                "type": "https",
                "detour": "Proxy",
                "domain_resolver": "dns-cn",
                "server": "cloudflare-dns.com"
            }
        ],
        "rules": [
            {
                "rule_set": [
                    "apple-cn",
                    "cn",
                    "games-cn",
                    "google-cn",
                    "microsoft-cn",
                    "private",
                    "DouYin"
                ],
                "server": "dns-cn"
            },
            {
                "server": "fakeip"
            }
        ],
        "final": "dns-proxy",
        "strategy": "prefer_ipv6",
        "optimistic": true
    },
    "inbounds": [
        {
            "tag": "tun-in",
            "type": "tun",
            "address": [
                "172.19.0.1/30",
                "fdfe:dcba:9876::1/126"
            ],
            "auto_route": true,
            "strict_route": true
        }
    ],
    "outbounds": [
        {
            "tag": "Proxy",
            "type": "selector",
            "outbounds": [
                "Direct"
            ],
            "interrupt_exist_connections": true
        },
        {
            "tag": "AI",
            "type": "selector",
            "outbounds": [],
            "interrupt_exist_connections": true
        },
        {
            "tag": "Games",
            "type": "selector",
            "outbounds": [
                "Direct"
            ],
            "interrupt_exist_connections": true
        },
        {
            "tag": "Spotify",
            "type": "selector",
            "outbounds": [
                "Direct"
            ],
            "interrupt_exist_connections": true
        },
        {
            "tag": "Direct",
            "type": "direct",
            "domain_resolver": {
                "server": "dns-cn",
                "strategy": "ipv4_only"
            }
        }
    ],
    "route": {
        "rule_set": [
            {
                "tag": [
                    "DouYin"
                ],
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/senshinya/singbox_ruleset/raw/main/rule/{tag}/{tag}.srs"
            },
            {
                "tag": [
                    "ai",
                    "apple-cn",
                    "cn",
                    "cnip",
                    "games-cn",
                    "games",
                    "google-cn",
                    "microsoft-cn",
                    "private",
                    "privateip",
                    "proxy",
                    "spotify",
                    "telegramip"
                ],
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/DustinWin/ruleset_geodata/raw/sing-box-ruleset/{tag}.srs"
            }
        ],
        "rules": [
            {
                "action": "sniff"
            },
            {
                "network": [
                    "tcp",
                    "udp"
                ],
                "port": 853,
                "action": "reject"
            },
            {
                "ip_is_private": true,
                "outbound": "Direct"
            },
            {
                "rule_set": [
                    "private",
                    "privateip",
                    "apple-cn",
                    "games-cn",
                    "google-cn",
                    "microsoft-cn",
                    "DouYin"
                ],
                "outbound": "Direct"
            },
            {
                "rule_set": "ai",
                "outbound": "AI"
            },
            {
                "rule_set": "games",
                "outbound": "Games"
            },
            {
                "rule_set": "spotify",
                "outbound": "Spotify"
            },
            {
                "rule_set": [
                    "telegramip",
                    "proxy"
                ],
                "outbound": "Proxy"
            },
            {
                "rule_set": [
                    "cn",
                    "cnip"
                ],
                "outbound": "Direct"
            }
        ],
        "auto_detect_interface": true,
        "default_http_client": "route-download",
        "default_domain_resolver": "dns-cn",
        "final": "Proxy"
    },
    "http_clients": [
        {
            "tag": "route-download",
            "detour": "Proxy"
        }
    ],
    "experimental": {
        "cache_file": {
            "enabled": true,
            "store_dns": true
        }
    }
}