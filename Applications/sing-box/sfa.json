{
    "$schema": "https://sing-box.sagernet.org/schema.json",
    "log": {
        "disabled": true,
        "level": "info",
        "output": "sing-box.log",
        "timestamp": true
    },
    "experimental": {
        "cache_file": {
            "enabled": true,
            "store_dns": true
        }
    },
    "dns": {
        "servers": [
            {
                "tag": "dns-cn",
                "type": "udp",
                "server": "223.5.5.5"
            },
            {
                "tag": "fakeip",
                "type": "fakeip",
                "inet4_range": "198.18.0.0/15",
                "inet6_range": "2001:2::/48"
            }
        ],
        "rules": [
            {
                "rule_set": [
                    "apple-cn",
                    "cn",
                    "games-cn",
                    "google-cn",
                    "microsoft-cn",
                    "private"
                ],
                "server": "dns-cn"
            },
            {
                "server": "fakeip"
            }
        ],
        "strategy": "prefer_ipv6",
        "optimistic": true
    },
    "inbounds": [
        {
            "tag": "tun-in",
            "type": "tun",
            "address": [
                "172.19.0.1/30",
                "fdfe:dcba:9876::1/126"
            ],
            "auto_route": true,
            "strict_route": true
        }
    ],
    "http_clients": [
        {
            "tag": "route-download",
            "detour": "Proxy"
        }
    ],
    "route": {
        "auto_detect_interface": true,
        "default_http_client": "route-download",
        "default_domain_resolver": "dns-cn",
        "final": "Proxy",
        "rules": [
            {
                "type": "logical",
                "mode": "and",
                "rules": [
                    {
                        "ip_version": 6
                    },
                    {
                        "default_interface_address": "2000::/3",
                        "invert": true
                    }
                ],
                "action": "reject",
                "no_drop": true
            },
            {
                "action": "sniff"
            },
            {
                "protocol": "dns",
                "action": "hijack-dns"
            },
            {
                "ip_is_private": true,
                "outbound": "Direct"
            },
            {
                "rule_set": [
                    "private",
                    "privateip",
                    "apple-cn",
                    "games-cn",
                    "google-cn",
                    "microsoft-cn"
                ],
                "outbound": "Direct"
            },
            {
                "rule_set": "ai",
                "outbound": "AI"
            },
            {
                "rule_set": "games",
                "outbound": "Games"
            },
            {
                "rule_set": "spotify",
                "outbound": "Spotify"
            },
            {
                "rule_set": [
                    "telegramip",
                    "proxy"
                ],
                "outbound": "Proxy"
            },
            {
                "rule_set": [
                    "cn",
                    "cnip"
                ],
                "outbound": "Direct"
            }
        ],
        "rule_set": [
            {
                "tag": [
                    "ai",
                    "apple-cn",
                    "cn",
                    "cnip",
                    "games-cn",
                    "games",
                    "google-cn",
                    "microsoft-cn",
                    "private",
                    "privateip",
                    "proxy",
                    "spotify",
                    "telegramip"
                ],
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/DustinWin/ruleset_geodata/raw/sing-box-ruleset/{tag}.srs"
            }
        ]
    },
    "outbounds": [
        {
            "tag": "Proxy",
            "type": "selector",
            "outbounds": [
                "Direct"
            ],
            "interrupt_exist_connections": true
        },
        {
            "tag": "AI",
            "type": "selector",
            "outbounds": [],
            "interrupt_exist_connections": true
        },
        {
            "tag": "Games",
            "type": "selector",
            "outbounds": [
                "Direct"
            ],
            "interrupt_exist_connections": true
        },
        {
            "tag": "Spotify",
            "type": "selector",
            "outbounds": [
                "Direct"
            ],
            "interrupt_exist_connections": true
        },
        {
            "tag": "Direct",
            "type": "direct"
        }
    ]
}