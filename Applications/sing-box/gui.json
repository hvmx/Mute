{
    "$schema": "https://sing-box.sagernet.org/schema.json",
    "log": {
        "disabled": true,
        "level": "info",
        "output": "sing-box.log",
        "timestamp": true
    },
    "dns": {
        "servers": [
            {
                "tag": "dns-ali",
                "type": "https",
                "server": "223.5.5.5",
                "tls": {
                    "server_name": "dns.alidns.com"
                }
            },
            {
                "tag": "dns-google",
                "type": "tls",
                "server": "8.8.8.8",
                "detour": "Global",
                "tls": {
                    "server_name": "dns.google"
                }
            }
        ],
        "rules": [
            {
                "rule_set": "ChinaDomain",
                "server": "dns-ali"
            },
            {
                "action": "evaluate",
                "server": "dns-google"
            },
            {
                "match_response": true,
                "rule_set": "ChinaIP",
                "server": "dns-ali"
            }
        ],
        "final": "dns-google",
        "strategy": "ipv4_only"
    },
    "inbounds": [
        {
            "tag": "tun-in",
            "type": "tun",
            "address": [
                "172.18.0.1/30"
            ],
            "auto_route": true,
            "strict_route": true
        }
    ],
    "outbounds": [
        {
            "tag": "Final",
            "type": "selector",
            "outbounds": [
                "Global",
                "Direct"
            ],
            "interrupt_exist_connections": true
        },
        {
            "tag": "Global",
            "type": "selector",
            "outbounds": [],
            "interrupt_exist_connections": true
        },
        {
            "tag": "AI",
            "type": "selector",
            "outbounds": [],
            "interrupt_exist_connections": true
        },
        {
            "tag": "Epic",
            "type": "selector",
            "outbounds": [
                "Direct"
            ],
            "interrupt_exist_connections": true
        },
        {
            "tag": "GitHub",
            "type": "selector",
            "outbounds": [
                "Direct"
            ],
            "interrupt_exist_connections": true
        },
        {
            "tag": "Google",
            "type": "selector",
            "outbounds": [],
            "interrupt_exist_connections": true
        },
        {
            "tag": "Microsoft",
            "type": "selector",
            "outbounds": [
                "Direct"
            ],
            "interrupt_exist_connections": true
        },
        {
            "tag": "Spotify",
            "type": "selector",
            "outbounds": [
                "Direct"
            ],
            "interrupt_exist_connections": true
        },
        {
            "tag": "Steam",
            "type": "selector",
            "outbounds": [
                "Direct"
            ],
            "interrupt_exist_connections": true
        },
        {
            "tag": "TikTok",
            "type": "selector",
            "outbounds": [],
            "interrupt_exist_connections": true
        },
        {
            "tag": "Twitter",
            "type": "selector",
            "outbounds": [],
            "interrupt_exist_connections": true
        },
        {
            "tag": "Direct",
            "type": "direct"
        }
    ],
    "route": {
        "rule_set": [
            {
                "tag": [
                    "AI",
                    "AppleCN",
                    "ChinaDomain",
                    "ChinaIP"
                ],
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/Repcz/Tool/raw/X/sing-box/Rules/{tag}.srs"
            },
            {
                "tag": [
                    "Epic",
                    "GitHub",
                    "Google",
                    "Microsoft",
                    "Spotify",
                    "SteamCN",
                    "Steam",
                    "Telegram",
                    "TikTok",
                    "Twitter",
                    "YouTube",
                    "YouTubeMusic"
                ],
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/senshinya/singbox_ruleset/raw/main/rule/{tag}/{tag}.srs"
            }
        ],
        "rules": [
            {
                "action": "sniff",
                "inbound": "tun-in"
            },
            {
                "protocol": "dns",
                "action": "hijack-dns"
            },
            {
                "protocol": "quic",
                "action": "reject"
            },
            {
                "ip_is_private": true,
                "outbound": "Direct"
            },
            {
                "rule_set": [
                    "AppleCN",
                    "SteamCN"
                ],
                "outbound": "Direct"
            },
            {
                "rule_set": "AI",
                "outbound": "AI"
            },
            {
                "rule_set": "Epic",
                "outbound": "Epic"
            },
            {
                "rule_set": [
                    "Google",
                    "YouTube",
                    "YouTubeMusic"
                ],
                "outbound": "Google"
            },
            {
                "rule_set": "GitHub",
                "outbound": "GitHub"
            },
            {
                "rule_set": "Microsoft",
                "outbound": "Microsoft"
            },
            {
                "rule_set": "Spotify",
                "outbound": "Spotify"
            },
            {
                "rule_set": "Steam",
                "outbound": "Steam"
            },
            {
                "rule_set": "Telegram",
                "outbound": "Global"
            },
            {
                "rule_set": "TikTok",
                "outbound": "TikTok"
            },
            {
                "rule_set": "Twitter",
                "outbound": "Twitter"
            },
            {
                "action": "resolve"
            },
            {
                "rule_set": [
                    "ChinaDomain",
                    "ChinaIP"
                ],
                "outbound": "Direct"
            }
        ],
        "auto_detect_interface": true,
        "default_http_client": "route-download",
        "default_domain_resolver": "dns-ali",
        "final": "Final"
    },
    "http_clients": [
        {
            "tag": "route-download",
            "detour": "GitHub"
        }
    ]
}