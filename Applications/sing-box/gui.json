{
    "$schema": "https://sing-box.sagernet.org/schema.json",
    "log": {
        "disabled": true,
        "level": "info",
        "output": "sing-box.log",
        "timestamp": true
    },
    "dns": {
        "servers": [
            {"tag": "hosts_fix","type": "hosts","predefined": {
                "dns.alidns.com": ["223.5.5.5","223.6.6.6"],
                "doh.pub": ["1.12.12.21","120.53.53.53"]}
            },
            {"tag": "ali-doh","type": "https","server": "dns.alidns.com","domain_resolver": "hosts_fix"},
            {"tag": "ali-udp","type": "udp","server": "223.5.5.5"},
            {"tag": "tx-doh","type": "https","server": "doh.pub","domain_resolver": "hosts_fix"},
            {"tag": "tx-udp","type": "udp","server": "119.29.29.29"},
            {"tag": "fakeip","type": "fakeip","inet4_range": "198.18.0.0/15","inet6_range": "fc00::/18"},
            {"tag": "local","type": "local","neighbor_domain": [".local",".lan"]}
        ],
        "rules": [
            {"query_type": "HTTPS","action": "reject"},
            {"domain_suffix": ["lancache.steamcontent.com","10099.com.cn","msftconnecttest.com","msftncsi.com","local","lan","home","internal","corp","example.com"],"server": "local"},
            {"query_type": ["A","AAAA"],"server": "fakeip","rewrite_ttl": 1},
            {"clash_mode": "Global", "server": "fakeip"},
            {"clash_mode": "Direct", "server": "local"},
            {"action": "evaluate","server": "ali-doh","tag": "ali"},
            {"action": "evaluate","server": "tx-doh","tag": "tencent"},
            {"match_response": "ali","response_rcode": "NOERROR","action": "respond","race": true},
            {"match_response": "tencent","response_rcode": "NOERROR","action": "respond","race": true}
        ],
        "reverse_mapping": true,
        "strategy": "ipv4_only",
        "optimistic": true,
        "final": "ali-doh"
    },
    "inbounds": [
        {
            "tag": "tun-in",
            "type": "tun",
            "address": [
                "172.18.0.1/30"
            ],
            "auto_route": true,
            "strict_route": true
        }
    ],
    "outbounds": [
        {
            "tag": "Final",
            "type": "selector",
            "outbounds": [
                "Global",
                "Direct"
            ],
            "default": "Global",
            "interrupt_exist_connections": true
        },
        {
            "tag": "Global",
            "type": "selector",
            "outbounds": [
                "Select"
            ],
            "default": "Select",
            "interrupt_exist_connections": true
        },
        {
            "tag": "Select",
            "type": "selector",
            "outbounds": [
                "Direct"
            ],
            "default": "Direct",
            "interrupt_exist_connections": true
        },
        {
            "tag": "Direct",
            "type": "direct"
        },
        {
            "tag": "Block",
            "type": "block"
        },
        {
            "tag": "AI",
            "type": "selector",
            "outbounds": [
                "Global"
            ],
            "default": "Global",
            "interrupt_exist_connections": true
        },
        {
            "tag": "Epic",
            "type": "selector",
            "outbounds": [
                "Global",
                "Direct"
            ],
            "default": "Direct",
            "interrupt_exist_connections": true
        },
        {
            "tag": "GitHub",
            "type": "selector",
            "outbounds": [
                "Global",
                "Direct"
            ],
            "default": "Global",
            "interrupt_exist_connections": true
        },
        {
            "tag": "Google",
            "type": "selector",
            "outbounds": [
                "Global"
            ],
            "default": "Global",
            "interrupt_exist_connections": true
        },
        {
            "tag": "Microsoft",
            "type": "selector",
            "outbounds": [
                "Direct"
            ],
            "default": "Direct",
            "interrupt_exist_connections": true
        },
        {
            "tag": "Spotify",
            "type": "selector",
            "outbounds": [
                "Direct"
            ],
            "default": "Direct",
            "interrupt_exist_connections": true
        },
        {
            "tag": "Steam",
            "type": "selector",
            "outbounds": [
                "Global",
                "Direct"
            ],
            "default": "Global",
            "interrupt_exist_connections": true
        },
        {
            "tag": "TikTok",
            "type": "selector",
            "outbounds": [
                "Global"
            ],
            "default": "Global",
            "interrupt_exist_connections": true
        },
        {
            "tag": "Twitter",
            "type": "selector",
            "outbounds": [
                "Global"
            ],
            "default": "Global",
            "interrupt_exist_connections": true
        }
    ],
    "route": {
        "rule_set": [
            {
                "tag": ["AI", "AppleCN", "ChinaDomain", "ChinaIP"],
                "type": "remote", "format": "binary",
                "url": "https://github.com/Repcz/Tool/raw/X/sing-box/Rules/{tag}.srs"
            },
            {
                "tag": ["Epic", "GitHub", "Google", "Microsoft", "Spotify", "SteamCN", 
                        "Steam", "Telegram", "TikTok", "Twitter", "YouTube", "YouTubeMusic"],
                "type": "remote", "format": "binary",
                "url": "https://github.com/senshinya/singbox_ruleset/raw/main/rule/{tag}/{tag}.srs"
            }
        ],
        "rules": [
            {"action": "sniff", "sniffer": ["http","tls","quic","dns"]},
            {"protocol": "dns", "action": "hijack-dns"},
            {"ip_is_private": true, "outbound": "Direct"},
            {"clash_mode": "Direct", "outbound": "Direct"},
            {"clash_mode": "Global", "outbound": "Global"},
            {"rule_set": ["AppleCN", "SteamCN"], "outbound": "Direct"},
            {"rule_set": "AI", "outbound": "AI"},
            {"rule_set": "Epic", "outbound": "Epic"},
            {"rule_set": ["Google", "YouTube", "YouTubeMusic"], "outbound": "Google"},
            {"rule_set": "GitHub", "outbound": "GitHub"},
            {"rule_set": "Microsoft", "outbound": "Microsoft"},
            {"rule_set": "Spotify", "outbound": "Spotify"},
            {"rule_set": "Steam", "outbound": "Steam"},
            {"rule_set": "Telegram", "outbound": "Global"},
            {"rule_set": "TikTok", "outbound": "TikTok"},
            {"rule_set": "Twitter", "outbound": "Twitter"},
            {"action": "resolve"},
            {"rule_set": ["ChinaDomain", "ChinaIP"], "outbound": "Direct"}
        ],
        "auto_detect_interface": true,
        "default_http_client": "default",
        "default_domain_resolver": "ali-udp",
        "final": "Final"
    },
    "http_clients": [
        {
            "tag": "default",
            "detour": "GitHub"
        }
    ],
    "services": [
        {
            "type": "api",
            "tag": "sing-box dashboard",
            "listen": "127.0.0.1",
            "listen_port": 9090,
            "secret": "",
            "access_control_allow_origin": [
                "http://sing-box-dashboard.sagernet.org",
                "http://dash.sing-box.app"
            ],
            "access_control_allow_private_network": true
        }
    ]
}